# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/scamshield
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/scamshield?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scamshield

# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Seed articles and quizzes on boot (idempotent)
SEED_ON_START=true
